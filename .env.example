# Copy to .env.local. Never commit real values.
MODEL_API_KEY=            # Meta Model API (api.meta.ai): hosted muse-spark-1.3 and muse-voice-transcribe-1.0
MODAL_PROXY_TOKEN_ID=     # Modal proxy token id (wk-...), used as Bearer <id>.<secret>
MODAL_PROXY_TOKEN_SECRET= # Modal proxy token secret (ws-...)
MODAL_ENDPOINT_URL=       # Modal shared endpoint base URL ending in /v1
BASETEN_API_KEY=          # Baseten Model APIs: Muse Spark Open
FIREWORKS_API_KEY=        # Fireworks: Muse Spark Open fallback
HEY_PISGAH_BUDGET_USD=5   # Hard stop per live run
HEY_PISGAH_MODE=mock      # mock | live | replay
